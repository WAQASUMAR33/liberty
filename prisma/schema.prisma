generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CASHIER
}

enum BillType {
  WHOLESALE
  RETAIL
  QUOTATION
}

enum PaymentType {
  CREDIT
  DEBIT
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  name      String
  role      Role     @default(CASHIER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  products      Product[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Brand {
  id        String    @id @default(cuid())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id             String       @id @default(cuid())
  code           String       @unique
  name           String
  costPrice      Decimal      @db.Decimal(10, 2)
  wholesalePrice Decimal      @db.Decimal(10, 2)
  retailPrice    Decimal      @db.Decimal(10, 2)
  stock          Int          @default(0)
  categoryId     String?
  category       Category?    @relation(fields: [categoryId], references: [id])
  brandId        String?
  brand          Brand?       @relation(fields: [brandId], references: [id])
  saleItems      SaleItem[]
  saleReturnItems SaleReturnItem[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model Customer {
  id         String     @id @default(cuid())
  name       String
  contact    String
  cnic       String?
  balance    Decimal    @default(0) @db.Decimal(15, 2)
  address    String?
  sales      Sale[]
  returns    SaleReturn[]
  ledgers    Ledger[]
  payments   Payment[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Sale {
  id          String     @id @default(cuid())
  billNumber  String     @unique
  date        DateTime   @default(now())
  type        BillType
  customerId  String
  customer    Customer   @relation(fields: [customerId], references: [id])
  total       Decimal    @db.Decimal(15, 2)
  discount    Decimal    @default(0) @db.Decimal(15, 2)
  netTotal    Decimal    @db.Decimal(15, 2)
  paidAmount  Decimal    @default(0) @db.Decimal(15, 2)
  balance     Decimal    @default(0) @db.Decimal(15, 2)
  items       SaleItem[]
  returns     SaleReturn[]
  ledgers     Ledger[]
  createdAt   DateTime   @default(now())
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String  @default("") // Custom product name at the time of sale
  quantity  Int
  price     Decimal @db.Decimal(10, 2)
  discount  Decimal @default(0) @db.Decimal(10, 2)
  subtotal  Decimal @db.Decimal(15, 2)
}

model SaleReturn {
  id           String           @id @default(cuid())
  returnNumber String           @unique
  date         DateTime         @default(now())
  saleId       String?
  sale         Sale?            @relation(fields: [saleId], references: [id])
  customerId   String
  customer     Customer         @relation(fields: [customerId], references: [id])
  totalAmount  Decimal          @db.Decimal(15, 2)
  refundAmount Decimal          @default(0) @db.Decimal(15, 2)
  creditAmount Decimal          @default(0) @db.Decimal(15, 2)
  remarks      String?
  items        SaleReturnItem[]
  ledgers      Ledger[]
  createdAt    DateTime         @default(now())
}

model SaleReturnItem {
  id           String     @id @default(cuid())
  saleReturnId String
  saleReturn   SaleReturn @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  name         String     @default("")
  quantity     Int
  price        Decimal    @db.Decimal(10, 2)
  subtotal     Decimal    @db.Decimal(15, 2)
}

model Ledger {
  id           String      @id @default(cuid())
  customerId   String
  customer     Customer    @relation(fields: [customerId], references: [id])
  date         DateTime    @default(now())
  description  String
  debit        Decimal     @default(0) @db.Decimal(15, 2)
  credit       Decimal     @default(0) @db.Decimal(15, 2)
  balance      Decimal     @db.Decimal(15, 2)
  saleId       String?
  sale         Sale?       @relation(fields: [saleId], references: [id])
  saleReturnId String?
  saleReturn   SaleReturn? @relation(fields: [saleReturnId], references: [id])
  paymentId    String?
  payment      Payment?    @relation(fields: [paymentId], references: [id])
  createdAt    DateTime    @default(now())
}

model Payment {
  id          String      @id @default(cuid())
  amount      Decimal     @db.Decimal(15, 2)
  date        DateTime    @default(now())
  type        PaymentType @default(CREDIT)
  method      String?     @default("CASH")
  remarks     String?
  description String?
  customerId  String
  customer    Customer    @relation(fields: [customerId], references: [id])
  ledgers     Ledger[]
  createdAt   DateTime    @default(now())
}
